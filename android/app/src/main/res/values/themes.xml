<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme under Compose; Compose draws everything, this only avoids a flash. -->
    <style name="Theme.Auxparty" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Auxparty.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Auxparty</item>
    </style>
</resources>
