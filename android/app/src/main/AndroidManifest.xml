<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- On-phone YouTube Music search. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Starting a track from the background needs "display over other apps":
         it's one of the few exemptions from Android 10+'s background activity limits. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Samsung in particular puts background apps to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (Android 11+): see which apps open music.youtube.com links,
         without asking for QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="music.youtube.com" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="Music Remote"
        android:theme="@android:style/Theme.Material">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Being an enabled notification listener is what unlocks
             MediaSessionManager.getActiveSessions() for other apps' players. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="Music Remote"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
